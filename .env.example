# Local-only JWT signing secret. Replace before deploying.
JWT_SECRET=replace-this-local-development-secret

# These defaults point to the services in compose.yaml.
MONGO_URI=mongodb://mongo:27017/moodify
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=moodify-local-redis

# Replace with a valid key to upload songs; the placeholder keeps the API bootable.
IMAGEKIT_PRIVATE_KEY=local-placeholder-imagekit-private-key

# Keep development mode for local HTTP; production cookies require HTTPS.
NODE_ENV=development
FRONTEND_URL=http://localhost:8080
